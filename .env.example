# Example env for local/host deployment. Copy to .env and fill values; do NOT commit .env to git.

# Basics
APP_ACCESS_TOKEN=replace-with-a-long-random-string
PORT=3000

# Primary AI provider keys (optional here; you can also set via the Settings UI in the running app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: enable Supabase backend (run supabase_schema.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: Domain and email for Caddy to provision TLS automatically. If you use the caddy service,
# set these and run with the 'tls' profile.
DOMAIN=yourdomain.com
CADDY_EMAIL=you@example.com
